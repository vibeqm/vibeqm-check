{
  "name": "vibeqm-check",
  "version": "0.4.2",
  "description": "Self-assessment for the Vibe Quality Model (VibeQM): fact checks on a repository, with evidence for every gate",
  "keywords": [
    "vibe-quality-model",
    "vqm",
    "ai-coding",
    "code-quality",
    "self-assessment",
    "maturity-model",
    "ai-agents",
    "vibeqm"
  ],
  "homepage": "https://github.com/vibeqm/vibeqm-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeqm/vibeqm-check.git"
  },
  "bugs": {
    "url": "https://github.com/vibeqm/vibeqm-check/issues"
  },
  "license": "MIT",
  "author": "Eduardo Sanchez",
  "type": "module",
  "bin": {
    "vibeqm-check": "dist/src/cli.js",
    "vqm-check": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
